generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("YEMNA_DATABASE_URL")
}

enum AppRole {
  USER
  MODERATOR
  SUPPORT
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING_VERIFICATION
  DELETED
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  ONLY_ME
  COMMUNITY
}
enum RelationPermission {
  EVERYONE
  FRIENDS
  NOBODY
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum ReactionType {
  LIKE
  LOVE
  SUPPORT
  WOW
  SAD
  ANGRY
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CommunityAuditAction {
  COMMUNITY_CREATED
  SETTINGS_UPDATED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  MEMBER_ROLE_UPDATED
  JOIN_REQUEST_CREATED
  JOIN_REQUEST_CANCELLED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  OWNERSHIP_TRANSFERRED
}

enum ConversationKind {
  DIRECT
  GROUP
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FOLLOW
  POST_REACTION
  POST_COMMENT
  CALL_INVITE
  COMMUNITY
  MESSAGE
  SYSTEM
}

enum SupportTicketCategory {
  ACCOUNT
  TECHNICAL
  SAFETY
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  COMMUNITY
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                 String        @id @default(cuid())
  email              String?       @unique
  phone              String?       @unique
  username           String?       @unique
  passwordHash       String
  displayName        String
  fullName           String?
  avatarUrl          String?
  bio                String?       @db.VarChar(500)
  city               String?
  governorate        String?
  role               AppRole       @default(USER)
  status             AccountStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sessions           AuthSession[]
  settings           UserSettings?
  posts              Post[]        @relation("postAuthor")
  comments           Comment[]     @relation("commentAuthor")
  reactions          Reaction[]
  savedPosts         SavedPost[]
  mediaAssets        MediaAsset[]  @relation("mediaOwner")
  stories            Story[]
  storyViews         StoryView[]   @relation("storyViewer")
  albums             Album[]
  outgoingFriendships Friendship[] @relation("friendRequester")
  incomingFriendships Friendship[] @relation("friendRecipient")
  following          Follow[]      @relation("followingUser")
  followers          Follow[]      @relation("followedUser")
  blockedUsers       Block[]       @relation("blocker")
  blockedByUsers     Block[]       @relation("blocked")
  dismissedSuggestions FriendSuggestionDismissal[] @relation("suggestionDismissedBy")
  hiddenFromSuggestions FriendSuggestionDismissal[] @relation("suggestionHiddenUser")
  ownedCommunities   Community[]   @relation("communityOwner")
  communityMemberships CommunityMember[]
  communityJoinRequests CommunityJoinRequest[] @relation("communityJoinRequester")
  reviewedCommunityJoinRequests CommunityJoinRequest[] @relation("communityJoinReviewer")
  communityAuditActions CommunityAuditLog[] @relation("communityAuditActor")
  communityAuditTargets CommunityAuditLog[] @relation("communityAuditTarget")
  conversationParticipations ConversationParticipant[]
  createdConversations Conversation[] @relation("conversationCreator")
  sentMessages       Message[]     @relation("messageSender")
  receivedNotifications Notification[] @relation("notificationRecipient")
  createdNotifications Notification[] @relation("notificationActor")
  supportTickets     SupportTicket[]
  submittedReports   ContentReport[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model AuthSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model UserSettings {
  userId              String         @id
  profileVisibility   PostVisibility @default(PUBLIC)
  showOnlineStatus    Boolean        @default(true)
    allowDirectMessages   Boolean           @default(true)
  friendRequestPermission RelationPermission @default(EVERYONE)
  followPermission       RelationPermission @default(EVERYONE)
  createdAt              DateTime          @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id          String         @id @default(cuid())
  authorId    String
  body        String?
  visibility  PostVisibility @default(PUBLIC)
  status      PostStatus     @default(PUBLISHED)
  shareOfId   String?
  publishedAt DateTime       @default(now())
  editedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  author      User           @relation("postAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  shareOf     Post?          @relation("postShares", fields: [shareOfId], references: [id], onDelete: SetNull)
  shares      Post[]         @relation("postShares")
  comments    Comment[]
  reactions   Reaction[]
  savedBy     SavedPost[]
  media       MediaAsset[]
  communityLinks CommunityPost[]

  @@index([authorId, status, publishedAt])
  @@index([status, visibility, publishedAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation("commentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("commentReplies")

  @@index([postId, createdAt])
}

model Reaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@index([postId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model MediaAsset {
  id              String    @id @default(cuid())
  ownerId         String
  postId          String?
  albumId         String?
  messageId       String?
  kind            MediaKind
  storageKey      String    @unique
  publicUrl       String?
  mimeType        String
  byteSize        Int
  width           Int?
  height          Int?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  owner           User      @relation("mediaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  post            Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  album           Album?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  message         Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  story           Story?

  @@index([ownerId, createdAt])
  @@index([albumId, createdAt])
  @@index([messageId, createdAt])
}

model Story {
  id        String     @id @default(cuid())
  authorId  String
  mediaId   String     @unique
  caption   String?    @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime   @default(now())
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  views     StoryView[]

  @@index([expiresAt, createdAt])
  @@index([authorId, createdAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  viewedAt  DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation("storyViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
  @@index([storyId, viewedAt])
}

model Album {
  id          String       @id @default(cuid())
  ownerId     String
  title       String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  coverUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assets      MediaAsset[]

  @@index([ownerId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("friendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("friendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followedId String
  createdAt  DateTime @default(now())
  follower   User     @relation("followingUser", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("followedUser", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model FriendSuggestionDismissal {
  id                String   @id @default(cuid())
  dismissingUserId  String
  dismissedUserId   String
  createdAt         DateTime @default(now())
  dismissingUser    User     @relation("suggestionDismissedBy", fields: [dismissingUserId], references: [id], onDelete: Cascade)
  dismissedUser     User     @relation("suggestionHiddenUser", fields: [dismissedUserId], references: [id], onDelete: Cascade)

  @@unique([dismissingUserId, dismissedUserId])
  @@index([dismissingUserId, createdAt])
}

model Community {
  id             String              @id @default(cuid())
  slug           String              @unique
  name           String
  description    String?             @db.VarChar(1000)
  coverUrl       String?
  visibility     CommunityVisibility @default(PUBLIC)
  ownerId        String
  conversationId String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          User                @relation("communityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  conversation   Conversation?       @relation("communityConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  members        CommunityMember[]
  joinRequests   CommunityJoinRequest[]
  auditLogs      CommunityAuditLog[]
  posts          CommunityPost[]

  @@index([visibility, createdAt])
  @@index([ownerId])
}

model CommunityMember {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId, joinedAt])
}

model CommunityJoinRequest {
  id          String                     @id @default(cuid())
  communityId String
  userId      String
  status      CommunityJoinRequestStatus @default(PENDING)
  reviewerId  String?
  respondedAt DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  community   Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  requester   User                       @relation("communityJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?                      @relation("communityJoinReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId, status, createdAt])
  @@index([userId, status, createdAt])
}

model CommunityAuditLog {
  id           String               @id @default(cuid())
  communityId  String
  actorId      String?
  targetUserId String?
  action       CommunityAuditAction
  metadata     Json?
  createdAt    DateTime             @default(now())
  community    Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor        User?                @relation("communityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?                @relation("communityAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
  @@index([actorId, createdAt])
}

model CommunityPost {
  id          String    @id @default(cuid())
  communityId String
  postId      String
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([communityId, postId])
  @@index([communityId, createdAt])
}

model Conversation {
  id          String                    @id @default(cuid())
  kind        ConversationKind          @default(DIRECT)
  title       String?
  createdById String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  createdBy   User                      @relation("conversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  community   Community?                @relation("communityConversation")
  participants ConversationParticipant[]
  messages    Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
  media          MediaAsset[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  linkUrl     String?
  sourceKey   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@unique([recipientId, sourceKey])
}

model SupportTicket {
  id        String                @id @default(cuid())
  userId    String
  category  SupportTicketCategory @default(OTHER)
  subject   String                @db.VarChar(180)
  body      String                @db.VarChar(4000)
  status    SupportTicketStatus   @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ContentReport {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String           @db.VarChar(180)
  details    String?          @db.VarChar(2000)
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}
